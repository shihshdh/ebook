{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EBOOK",
  "mainBinaryName": "EBOOK",
  "version": "0.3.12",
  "identifier": "app.librarium.reader",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 5181",
    "devUrl": "http://localhost:5181",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "EBOOK",
    "category": "Education",
    "shortDescription": "EBOOK · 轻小说阅读器",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
